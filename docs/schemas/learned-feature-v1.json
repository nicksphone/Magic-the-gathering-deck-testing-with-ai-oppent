{
  "module": "training.decision_frame",
  "decision_version": "mtg.decision.v1",
  "feature_version": "mtg.features.v1",
  "functions": {
    "build_decision_frame": "(observation,prompts)->(frame,private_bindings)",
    "encode_state": "(frame)->EncodedTree",
