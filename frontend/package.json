{
  "name": "mtg-deck-testing-lab-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run test:unit",
    "test:browser": "node tests/browser-human-actions.mjs",
    "test:unit": "node --experimental-strip-types tests/api-errors.mjs && node --experimental-strip-types tests/api-routing.mjs && node --experimental-strip-types tests/match-contract.mjs && node --experimental-strip-types tests/simulation-contract.mjs && node --experimental-strip-types tests/mutation-gate.mjs",
    "test:browser:recovery": "node tests/browser-recovery.mjs",
    "lint": "eslint src"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^5.4.8"
  }
}
