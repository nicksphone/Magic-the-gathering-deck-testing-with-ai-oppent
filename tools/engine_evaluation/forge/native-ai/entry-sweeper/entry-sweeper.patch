+        private static boolean isSupportedEntrySweep(final Map<String, String> body, final IHasSVars vars,
+                final SpellAbility root) {
+            if (!Set.of("DB", "ValidCards", "NumAtt", "NumDef", "IsCurse", "Duration", "SpellDescription")
+                    .containsAll(body.keySet()) || !"PumpAll".equals(body.get("DB"))
+                    || !"True".equals(body.get("IsCurse"))
+                    || !Set.of("Creature", "Creature.OppCtrl", "Creature.Other").contains(body.getOrDefault("ValidCards", ""))
+                    || !"UntilEndOfTurn".equals(body.getOrDefault("Duration", "UntilEndOfTurn"))) return false;
+            final String toughness = body.get("NumDef");
+            if (toughness == null || !(toughness.equals(body.get("NumAtt")) || "0".equals(body.get("NumAtt")))) return false;
+            if ("-X".equals(toughness)) {
+                return root.getPayCosts() != null && root.getPayCosts().getTotalMana().countX() > 0
+                        && "Count$xPaid".equals(vars.getSVar("X"));
+            }
+            final Integer fixed = Ints.tryParse(toughness);
+            return fixed != null && fixed < 0;
+        }
