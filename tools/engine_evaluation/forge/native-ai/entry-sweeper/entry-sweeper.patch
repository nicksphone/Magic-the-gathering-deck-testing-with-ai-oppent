+                if (!Set.of("Mode", "Origin", "Destination", "ValidCard", "Execute", "TriggerZones",
+                        "TriggerDescription").containsAll(trigger.getMapParams().keySet())
+                        || !Set.of("Any", "Stack").contains(trigger.getParamOrDefault("Origin", "Any"))
+                        || !Set.of("Card.Self", "Creature.Self", "Permanent.Self", "Artifact.Self", "Enchantment.Self")
+                                .contains(trigger.getParamOrDefault("ValidCard", ""))
+                        || !"Battlefield".equals(trigger.getParamOrDefault("TriggerZones", "Battlefield"))
+                        || !trigger.phasesCheck(source.getGame())
+                        || !trigger.matchesValidParam("ValidCard", source)
+                        || (trigger.getActiveZone() != null && !trigger.getActiveZone().isEmpty()
+                                && !trigger.getActiveZone().contains(ZoneType.Battlefield))) return false;
+                final SpellAbility override = trigger.getOverridingAbility();
+                if (override != null) {
+                    // The effective ability is authoritative; never fall back to a printed Execute.
+                    if (!(override instanceof AbilitySub) || override.getHostCard() != source
+                            || override.getApi() != ApiType.PumpAll || override.getParent() != null
+                            || override.getSubAbility() != null || override.usesTargeting()
+                            || override.getRestrictions() != null
+                            || !override.getAdditionalAbilities().isEmpty() || !override.getAdditionalAbilityLists().isEmpty()
+                            || (override.getPayCosts() != null && !override.getPayCosts().isFree())
+                            || override.getConditions() == null
+                            || override.getConditions().getClass() != SpellAbilityCondition.class
+                            || !EqualsBuilder.reflectionEquals(override.getConditions(), DEFAULT_ENTRY_CONDITION, true)
+                            || !isSupportedEntrySweep(override.getMapParams(), override, root)) return false;
