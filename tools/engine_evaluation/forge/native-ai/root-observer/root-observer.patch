+    private final class DecisionCollector {
+        private static final int LIMIT = 4096;
+        private final long root = ++decisionRoot;
+        private final int gameId = game.getId();
+        private final int actorId = player.getId();
+        private final int turn = game.getPhaseHandler().getTurn();
+        private final String phase = game.getPhaseHandler().getPhase() == null
+                ? null : game.getPhaseHandler().getPhase().name();
+        private final List<DecisionVisit> visits = new ArrayList<>();
+        private final java.util.concurrent.locks.ReentrantLock lock = new java.util.concurrent.locks.ReentrantLock();
+        private final java.util.concurrent.atomic.AtomicInteger batches = new java.util.concurrent.atomic.AtomicInteger();
+        private final java.util.concurrent.atomic.AtomicInteger identities = new java.util.concurrent.atomic.AtomicInteger();
+        private volatile boolean closed;
+        private volatile boolean truncated;
+
+        private DecisionAction identity(SpellAbility sa) {
+            Card host = sa == null ? null : sa.getHostCard();
+            if (host == null || host.isFaceDown() || !host.getView().canBeShownTo(player.getView())) {
+                return new DecisionAction(null, null, null, null);
+            }
+            return new DecisionAction(sa.getId(), host.getId(), host.getName(),
+                    sa.getApi() == null ? null : sa.getApi().name());
+        }
+
+        private List<DecisionAction> identities(List<SpellAbility> all, boolean visitBudget) {
+            if (all == null) return null;
+            List<DecisionAction> values = new ArrayList<>();
+            for (SpellAbility sa : all) {
+                if (values.size() >= LIMIT || (visitBudget && identities.getAndIncrement() >= LIMIT)) {
+                    truncated = true;
+                    break;
+                }
+                values.add(identity(sa));
+            }
+            return values;
+        }
+
+        private int offered(List<SpellAbility> all) {
+            int batch = batches.incrementAndGet();
+            add("OFFERED", batch, all, null);
+            return batch;
+        }
+
+        private void add(String stage, int batch, List<SpellAbility> all, String opinion) {
+            if (closed) return;
+            final List<DecisionAction> actions;
+            try {
+                // Read engine identities outside the collector lock, never delaying timeout cancellation.
+                actions = identities(all, true);
+            } catch (RuntimeException failure) {
+                truncated = true;
+                decisionObserverFailures.incrementAndGet();
+                return;
+            }
+            if (!lock.tryLock()) {
+                truncated = true;
+                return;
+            }
+            try {
+                if (closed) return;
+                if (visits.size() >= LIMIT) truncated = true;
+                else visits.add(new DecisionVisit(stage, batch, actions, opinion, null));
+            } finally {
+                lock.unlock();
+            }
+        }
+
+        private DecisionTrace finish(String outcome, List<SpellAbility> chosen) {
+            closed = true; // A cancelled eval worker cannot append to the next root's trace.
+            List<DecisionAction> selected = identities(chosen, false);
+            List<DecisionVisit> frozen = List.of();
+            if (lock.tryLock()) {
+                try {
+                    frozen = List.copyOf(visits);
+                } finally {
+                    lock.unlock();
+                }
+            } else {
+                truncated = true;
+            }
+            return new DecisionTrace(root, gameId, actorId, turn, phase, outcome, chosen == null,
+                    selected == null ? List.of() : selected, frozen, false, truncated);
+        }
+    }
