+
+    private static boolean hasKnownWinningSacrificeCost(final Player ai, final SpellAbility sa) {
+        // Visibility comes before inspecting the ability's API, cost or subabilities.
+        if (ai == null || sa == null || !knownTo(ai, sa.getHostCard())) return false;
+        if (sa.isTrigger() || sa.isManaAbility() || (!sa.isSpell() && !sa.isActivatedAbility())
+                || sa.getPayCosts() == null || ai.getOpponents().size() != 1
+                || sa.getParent() != null || !sa.getAdditionalAbilities().isEmpty()
+                || !sa.getAdditionalAbilityLists().isEmpty()) {
+            return false;
+        }
+        CostSacrifice sacrifice = null;
+        for (CostPart part : sa.getPayCosts().getCostParts()) {
+            if (part instanceof CostSacrifice sac) {
+                if (sacrifice != null || !"1".equals(sac.getAmount())
+                        || !(Set.of("Creature", "Creature.Other", "Creature.YouCtrl", "Creature.Other+YouCtrl")
+                                .contains(sac.getType()) || sac.payCostFromSource())) return false;
+                sacrifice = sac;
+            } else if (part instanceof CostPartMana mana) {
+                if (mana.getMana().countX() != 0 || mana.getMana().hasPhyrexian()) return false;
+            } else if (!(part instanceof CostTap)) {
+                return false;
+            }
+        }
+        if (sacrifice == null) return false;
+        final Player opponent = ai.getOpponents().get(0);
+        if (opponent.getLife() <= 0 || ai.getLife() <= 0) return false;
+        final CardCollection sources = new CardCollection();
+        for (Card card : ai.getGame().getCardsIn(ZoneType.STATIC_ABILITIES_SOURCE_ZONES)) {
+            if (!knownTo(ai, card) || card.isPhasedOut()) continue;
+            sources.add(card);
+            for (ReplacementEffect replacement : card.getReplacementEffects()) {
+                if (replacement.isSuppressed() || !replacement.zonesCheck(ai.getGame().getZoneOf(card))) continue;
+                final ReplacementType mode = replacement.getMode();
+                if (mode == ReplacementType.GameLoss || mode == ReplacementType.GameWin
+                        || mode == ReplacementType.GainLife || (mode == ReplacementType.LifeReduced
+                            && !"True".equals(replacement.getParam("IsDamage")))
+                        || (mode == ReplacementType.Moved
+                            && mayIncludeZone(replacement.getParam("Origin"), ZoneType.Battlefield)
+                            && mayIncludeZone(replacement.getParam("Destination"), ZoneType.Graveyard))) {
+                    return false;
+                }
+            }
+            for (StaticAbility ability : card.getStaticAbilities()) {
+                if (ability.isSuppressed() || (ability.getActiveZone() != null
+                        && !ability.getActiveZone().contains(card.getZone().getZoneType()))) continue;
+                if (ability.getMode().contains(StaticAbilityMode.DisableTriggers)
+                        || ability.getMode().contains(StaticAbilityMode.CantTarget)
+                        || ability.getMode().contains(StaticAbilityMode.MustTarget)
+                        || ability.getMode().contains(StaticAbilityMode.CantLoseLife)
+                        || ability.getMode().contains(StaticAbilityMode.CantChangeLife)) return false;
+            }
+        }
+        boolean candidate = false;
+        for (Card victim : ai.getCardsIn(ZoneType.Battlefield)) {
+            if (!knownTo(ai, victim) || !victim.canBeSacrificedBy(sa, false)) continue;
+            if (sacrifice.payCostFromSource() ? victim != sa.getHostCard()
+                    : !victim.isValid(sacrifice.getType().split(";"), ai, sa.getHostCard(), sa)) continue;
+            if (!victim.isCreature()) return false;
+            candidate = true;
+            long lifeLoss = 0;
+            for (Card card : sources) {
+                for (Trigger trigger : card.getTriggers()) {
+                    if (trigger.isSuppressed() || !trigger.zonesCheck(ai.getGame().getZoneOf(card))) continue;
+                    if (trigger.getMode() == TriggerType.ChangesZone) {
+                        if (!mayIncludeZone(trigger.getParam("Origin"), ZoneType.Battlefield)) continue;
+                        if (!mayIncludeZone(trigger.getParam("Destination"), ZoneType.Graveyard)) continue;
+                    } else {
+                        // Unknown simultaneous cost triggers may alter the supposedly terminal line.
+                        return false;
+                    }
+                    if (!trigger.getParamOrDefault("ValidCard", "").matches(
+                            "(?:Card\\.Self|Creature(?:\\.Other)?(?:\\+YouCtrl)?)(?:,Creature\\.Other(?:\\+YouCtrl)?)?")) return false;
+                    if (!trigger.matchesValidParam("ValidCard", victim)) continue;
+                    if (!card.getController().equals(ai)
+                            || !Set.of("Mode", "Origin", "Destination", "ValidCard", "TriggerZones", "Execute", "TriggerDescription")
+                                .containsAll(trigger.getMapParams().keySet())
+                            || !"Battlefield".equals(trigger.getParam("Origin"))
+                            || !"Graveyard".equals(trigger.getParam("Destination"))
+                            || !trigger.hasParam("Execute") || !trigger.hasSVar(trigger.getParam("Execute"))) return false;
+                    // The native executor prefers an effective override to the printed SVar.
+                    // Inspect an existing one without ensureAbility(), caching, or allocating an ability.
+                    final SpellAbility effective = trigger.getOverridingAbility();
+                    if (effective != null && (effective.getClass() != AbilitySub.class
+                            || effective.getApi() != ApiType.LoseLife || effective.isWrapper() || effective.getParent() != null
+                            || !effective.getAdditionalAbilities().isEmpty()
+                            || !effective.getAdditionalAbilityLists().isEmpty())) return false;
+                    final Map<String, String> loss = effective == null
+                            ? AbilityFactory.getMapParams(trigger.getSVar(trigger.getParam("Execute")))
+                            : effective.getMapParams();
+                    if (!Set.of("DB", "LifeAmount", "Defined", "ValidTgts", "SubAbility").containsAll(loss.keySet())
+                            || !"LoseLife".equals(loss.get("DB"))
+                            || !loss.getOrDefault("LifeAmount", "").matches("[1-9][0-9]{0,8}")) return false;
+                    final boolean targeted = "Player".equals(loss.get("ValidTgts")) && !loss.containsKey("Defined");
+                    if (!targeted && !("Player.Opponent".equals(loss.get("Defined")) && !loss.containsKey("ValidTgts"))) return false;
+                    if (targeted && !Iterables.isEmpty(opponent.getKeywords())) return false;
+                    if (effective != null && ((effective.getSubAbility() != null) != loss.containsKey("SubAbility"))) return false;
+                    if (loss.containsKey("SubAbility")) {
+                        if (!trigger.hasSVar(loss.get("SubAbility"))) return false;
+                        final SpellAbility child = effective == null ? null : effective.getSubAbility();
+                        if (child != null && (child.getClass() != AbilitySub.class
+                                || child.getApi() != ApiType.GainLife || child.getSubAbility() != null
+                                || !child.getAdditionalAbilities().isEmpty()
+                                || !child.getAdditionalAbilityLists().isEmpty())) return false;
+                        final Map<String, String> gain = child == null
+                                ? AbilityFactory.getMapParams(trigger.getSVar(loss.get("SubAbility"))) : child.getMapParams();
+                        if (!Set.of("DB", "Defined", "LifeAmount").equals(gain.keySet())
+                                || !"GainLife".equals(gain.get("DB")) || !"You".equals(gain.get("Defined"))
+                                || !gain.get("LifeAmount").matches("[1-9][0-9]{0,8}")) return false;
+                    }
+                    lifeLoss += Integer.parseInt(loss.get("LifeAmount"));
+                }
+            }
+            // Every eligible payment must win: don't forecast one victim then pay with another.
+            if (lifeLoss < opponent.getLife()) return false;
+        }
+        return candidate;
+    }
+
+    private static boolean knownTo(final Player ai, final Card card) {
+        return card != null && card.getView().canBeShownTo(ai.getView())
+                && card.getView().canFaceDownBeShownTo(ai.getView());
+    }
+
+    private static boolean mayIncludeZone(final String zones, final ZoneType wanted) {
+        if (zones == null) return true;
+        for (String zone : zones.split(",", -1)) {
+            if ("Any".equals(zone) || wanted.toString().equals(zone)) return true;
+            try {
+                ZoneType.valueOf(zone);
+            } catch (IllegalArgumentException unknown) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static boolean hasLegalAnnouncedTargets(final SpellAbility root) {
+        for (SpellAbility ability = root; ability != null; ability = ability.getSubAbility()) {
+            if (!ability.isTargetNumberValid()) return false;
+            for (GameObject target : ability.getTargets()) {
+                if (!ability.canTarget(target, true)) return false;
+            }
+        }
+        return true;
     }
 
