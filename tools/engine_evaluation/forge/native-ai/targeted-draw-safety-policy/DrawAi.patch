+    private static boolean hasKnownDrawWinReplacement(final Player ai, final Player opponent) {
+        final Game game = ai.getGame();
+        for (final Card source : game.getCardsInGame()) {
+            if (!source.getView().canBeShownTo(ai.getView())
+                    || !source.getView().canFaceDownBeShownTo(ai.getView())) {
+                continue;
+            }
+            for (final ReplacementEffect replacement : source.getReplacementEffects()) {
+                if (replacement.getMode() != ReplacementType.Draw || replacement.isSuppressed()
+                        || !replacement.zonesCheck(game.getZoneOf(source))
+                        || !replacement.matchesValidParam("ValidPlayer", opponent)) {
+                    continue;
+                }
+                // Empty-library conditions can become true during the draw sequence.
+                if (containsWinInstruction(replacement.ensureAbility())) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    private static boolean containsWinInstruction(final SpellAbility root) {
+        if (root == null) {
+            return false;
+        }
+        final ArrayDeque<SpellAbility> pending = new ArrayDeque<>();
+        final Set<SpellAbility> seen = Collections.newSetFromMap(new IdentityHashMap<>());
+        pending.add(root);
+        while (!pending.isEmpty()) {
+            final SpellAbility ability = pending.removeFirst();
+            if (!seen.add(ability)) {
+                continue;
+            }
+            if (ability.getApi() == ApiType.WinsGame) {
+                return true;
+            }
+            if (ability.getSubAbility() != null) {
+                pending.add(ability.getSubAbility());
+            }
+            pending.addAll(ability.getAdditionalAbilities().values());
+            for (final var children : ability.getAdditionalAbilityLists().values()) {
+                pending.addAll(children);
+            }
+        }
+        return false;
+    }
