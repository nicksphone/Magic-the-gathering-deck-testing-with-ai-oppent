+    private boolean completeLethalLinkedDamage(final Player ai, final SpellAbility child, final int damage) {
+        final List<Card> targets = getSupportedLinkedDamageTargets(ai, child, damage);
+        if (targets == null) return false;
+        final SpellAbility root = child.getRootAbility();
+        final SpellAbility resolve = child.getSubAbility();
+        final Player enemy = root.getTargets().getFirstTargetedPlayer();
+        if (targets.isEmpty()) {
+            return false;
+        }
+        // Preserve the existing lethal completion; pressure needs a separate safe target/value check.
+        if (isLethalDamageToPlayer(enemy, root.getHostCard(), damage, root.hasParam("NoPrevention"))) {
+            child.getTargets().add(targets.get(0));
+            return true;
+        }
+        if (!enemy.canLoseLife() || enemy.cantLoseForZeroOrLessLife()
+                || root.getHostCard().isInfectDamage(enemy) || avoidTargetP(ai, root)
+                || ComputerUtilCombat.predictDamageTo(enemy, damage, root.getHostCard(), false) <= 0) {
+            return false;
+        }
+        for (final SpellAbility part : Arrays.asList(root, child, resolve)) {
+            if (part.getConditions() == null || part.getConditions().getClass() != SpellAbilityCondition.class
+                    || !EqualsBuilder.reflectionEquals(part.getConditions(), DEFAULT_LINKED_CONDITION, true)
+                    || !part.getAdditionalAbilities().isEmpty() || !part.getAdditionalAbilityLists().isEmpty()) {
+                return false;
+            }
+        }
+        targets.removeIf(target -> !target.getView().canBeShownTo(ai.getView())
+                || !target.getView().canFaceDownBeShownTo(ai.getView())
+                || ComputerUtilCombat.predictDamageTo(target, damage, root.getHostCard(), false) <= 0
+                || target.getTriggers().stream().anyMatch(trigger -> !trigger.isSuppressed()
+                        && Arrays.asList(TriggerType.BecomesTarget, TriggerType.BecomesTargetOnce,
+                                TriggerType.DamageDone, TriggerType.DamageDoneOnce,
+                                TriggerType.DamageDoneOnceByController, TriggerType.DamageDealtOnce,
+                                TriggerType.DamageAll, TriggerType.DamagePreventedOnce,
+                                TriggerType.ExcessDamage, TriggerType.ExcessDamageAll).contains(trigger.getMode()))
+                || target.getReplacementEffects().stream().anyMatch(replacement -> !replacement.isSuppressed()
+                        && "DamageDone".equals(replacement.getParam("Event"))));
+        final Card target = ComputerUtilCard.getBestRemovalTargetAI(ai,
+                ComputerUtil.filterAITgts(child, ai, new CardCollection(targets), true));
+        if (target == null) return false;
+        child.getTargets().add(target);
         return true;
+    }
+
+    private boolean targetLinkedPressure(final Player ai, final SpellAbility root, final int damage) {
+        final SpellAbility child = root.getSubAbility();
+        final Player enemy = ai.getWeakestOpponent();
+        final Game game = ai.getGame();
+        final PhaseHandler phase = game.getPhaseHandler();
+        // Only the new root admission waits; existing native root choices keep their normal timing.
+        if (!game.getStack().isEmpty() || !phase.isPlayerTurn(ai)
+                || !(phase.is(PhaseType.MAIN2) || phase.is(PhaseType.END_OF_TURN))
+                || child == null || root.getParent() != null || !root.usesTargeting() || !root.canTarget(enemy)) {
+            return false;
+        }
+        root.resetTargets();
+        root.getTargets().add(enemy);
+        child.resetTargets();
+        if (completeLethalLinkedDamage(ai, child, damage)) return true;
+        root.resetTargets();
+        return false;
     }
 
