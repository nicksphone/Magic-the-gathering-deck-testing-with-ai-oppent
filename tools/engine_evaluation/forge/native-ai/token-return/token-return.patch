+    private static int knownLiteralLoss(final Trigger trigger, final Player opponent) {
+        if (!trigger.hasParam("Execute") || !trigger.hasSVar(trigger.getParam("Execute"))) return -1;
+        // Inspect the effective native body without ensureAbility(), caches or ability allocation.
+        final SpellAbility effective = trigger.getOverridingAbility();
+        if (effective != null && (effective.getClass() != AbilitySub.class
+                || effective.getApi() != ApiType.LoseLife || effective.isWrapper() || effective.getParent() != null
+                || !effective.getAdditionalAbilities().isEmpty()
+                || !effective.getAdditionalAbilityLists().isEmpty())) return -1;
+        final Map<String, String> loss = effective == null
+                ? AbilityFactory.getMapParams(trigger.getSVar(trigger.getParam("Execute"))) : effective.getMapParams();
+        if (!Set.of("DB", "LifeAmount", "Defined", "ValidTgts", "SubAbility").containsAll(loss.keySet())
+                || !"LoseLife".equals(loss.get("DB"))
+                || !loss.getOrDefault("LifeAmount", "").matches("[1-9][0-9]{0,8}")) return -1;
+        final boolean targeted = "Player".equals(loss.get("ValidTgts")) && !loss.containsKey("Defined");
+        if (!targeted && !("Player.Opponent".equals(loss.get("Defined")) && !loss.containsKey("ValidTgts"))) return -1;
+        if (targeted && !Iterables.isEmpty(opponent.getKeywords())) return -1;
+        if (effective != null && ((effective.getSubAbility() != null) != loss.containsKey("SubAbility"))) return -1;
+        if (loss.containsKey("SubAbility")) {
+            if (!trigger.hasSVar(loss.get("SubAbility"))) return -1;
+            final SpellAbility child = effective == null ? null : effective.getSubAbility();
+            if (child != null && (child.getClass() != AbilitySub.class
+                    || child.getApi() != ApiType.GainLife || child.getSubAbility() != null
+                    || !child.getAdditionalAbilities().isEmpty()
+                    || !child.getAdditionalAbilityLists().isEmpty())) return -1;
+            final Map<String, String> gain = child == null
+                    ? AbilityFactory.getMapParams(trigger.getSVar(loss.get("SubAbility"))) : child.getMapParams();
+            if (!Set.of("DB", "Defined", "LifeAmount").equals(gain.keySet())
+                    || !"GainLife".equals(gain.get("DB")) || !"You".equals(gain.get("Defined"))
+                    || !gain.get("LifeAmount").matches("[1-9][0-9]{0,8}")) return -1;
+        }
+        return Integer.parseInt(loss.get("LifeAmount"));
+    }
