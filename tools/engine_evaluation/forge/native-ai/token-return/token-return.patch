+    private static boolean simpleAbility(final SpellAbility sa) {
+        return !sa.isTrigger() && sa.getPayCosts() != null && sa.getParent() == null
+                && sa.getSubAbility() == null && !sa.usesTargeting() && !sa.isWrapper()
+                && sa.getAdditionalAbilities().isEmpty() && sa.getAdditionalAbilityLists().isEmpty();
+    }
