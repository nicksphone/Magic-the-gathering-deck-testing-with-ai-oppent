+    private static long moveLoss(final Player ai, final CardCollection sources, final Card moved, final CardRules token,
+            final ZoneType origin, final ZoneType destination, final Card removed) {
+        long loss = 0;
+        for (Card card : sources) {
+            if (card == removed && !(card == moved && destination == ZoneType.Battlefield)) continue;
+            final boolean returning = card == moved && destination == ZoneType.Battlefield;
+            for (Trigger trigger : card.getTriggers()) {
+                if (trigger.isSuppressed() || (!returning && !trigger.zonesCheck(ai.getGame().getZoneOf(card)))) continue;
+                if (trigger.getMode() != TriggerType.ChangesZone) return -1;
+                if (!mayIncludeZone(trigger.getParam("Origin"), origin)
+                        || !mayIncludeZone(trigger.getParam("Destination"), destination)) continue;
+                final String valid = trigger.getParamOrDefault("ValidCard", "");
+                if (!valid.matches("(?:Card|Permanent|Creature|Artifact|Enchantment|Land)(?:\\.(?:Self|Other)(?:\\+YouCtrl)?|\\.YouCtrl)?"
+                        + "(?:,(?:Card|Permanent|Creature|Artifact|Enchantment|Land)(?:\\.(?:Self|Other)(?:\\+YouCtrl)?|\\.YouCtrl)?)?")) return -1;
+                boolean matches = false;
+                if (moved != null) matches = trigger.matchesValidParam("ValidCard", moved);
+                else for (String alternative : valid.split(",")) {
+                    if (!alternative.contains(".Self") && (alternative.startsWith("Card") || alternative.startsWith("Permanent")
+                            || token.getType().hasStringType(alternative.split("\\.")[0]))) matches = true;
+                }
+                if (!matches) continue;
+                if (token != null || !card.getController().equals(ai)
+                        || !Set.of("Mode", "Origin", "Destination", "ValidCard", "TriggerZones", "Execute", "TriggerDescription")
+                            .containsAll(trigger.getMapParams().keySet())) return -1;
+                final int amount = knownLiteralLoss(trigger, ai.getOpponents().get(0));
+                if (amount < 0) return -1;
+                loss += amount;
+            }
+        }
+        return loss;
+    }
