+    /** Conservatively checks current source visibility without evaluating trigger rules or bodies. */
+    public boolean hasObserverVisibleDelayedTrigger(final Player observer) {
+        if (observer == null || observer.getGame() != game || !game.getPlayers().contains(observer)) {
+            return true;
+        }
+        for (final Trigger trigger : delayedTriggers) {
+            final Card source = trigger.getHostCard();
+            if (source != null && source.getView().canBeShownTo(observer.getView())
+                    && source.getView().canFaceDownBeShownTo(observer.getView())) {
+                return true;
+            }
+        }
+        return false;
+    }
