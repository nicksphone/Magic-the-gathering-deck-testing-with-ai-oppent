+    private static CardCollection tokenReturnSources(final Player ai) {
+        if (ai.getOpponents().size() != 1 || ai.getLife() <= 0 || ai.getOpponents().get(0).getLife() <= 0
+                || ai.getGame().getTriggerHandler().hasObserverVisibleDelayedTrigger(ai)) return null;
+        final CardCollection sources = new CardCollection();
+        for (Card card : ai.getGame().getCardsIn(ZoneType.STATIC_ABILITIES_SOURCE_ZONES)) {
+            if (!knownTo(ai, card) || card.isPhasedOut()) continue;
+            sources.add(card);
+            for (ReplacementEffect replacement : card.getReplacementEffects()) {
+                if (!replacement.isSuppressed() && replacement.zonesCheck(ai.getGame().getZoneOf(card))) return null;
+            }
+            for (StaticAbility ability : card.getStaticAbilities()) {
+                if (!ability.isSuppressed() && (ability.getActiveZone() == null
+                        || ability.getActiveZone().contains(card.getZone().getZoneType()))
+                        && !Set.of(StaticAbilityMode.CantAttack, StaticAbilityMode.CantAttackUnless,
+                            StaticAbilityMode.CantBlock, StaticAbilityMode.CantBlockBy, StaticAbilityMode.CantBlockUnless,
+                            StaticAbilityMode.CanBlockIfReach, StaticAbilityMode.BlockTapped, StaticAbilityMode.AttackVigilance)
+                            .containsAll(ability.getMode())) return null;
+            }
+        }
+        return sources;
+    }
