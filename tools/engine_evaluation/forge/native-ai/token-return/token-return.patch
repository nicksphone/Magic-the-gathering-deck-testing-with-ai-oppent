+    private static boolean unrestrictedVariables(final SpellAbilityVariables variables) {
+        return !variables.isSorcerySpeed() && !variables.isInstantSpeed() && !variables.getPlayerTurn()
+                && !variables.getOpponentTurn() && variables.getPhases().isEmpty() && variables.getGameTypes().isEmpty()
+                && !variables.getFirstCombatOnly() && !variables.getAfterBlockersOnly()
+                && "You".equals(variables.getActivator()) && variables.getLimitToCheck() == null
+                && variables.getGameLimitToCheck() == null && !variables.isThreshold() && !variables.isMetalcraft()
+                && !variables.isDelirium() && !variables.isHellbent() && !variables.isRevolt()
+                && !variables.isBlessing() && !variables.isEnduringStory() && !variables.isSolved()
+                && variables.getIsPresent() == null && variables.getIsPresent2() == null
+                && variables.getPresentDefined() == null && variables.getPresentDefined2() == null
+                && variables.getPlayerDefined() == null && variables.getPlayerContains() == null
+                && variables.getsVarToCheck() == null && variables.getsVarToCheck2() == null
+                && variables.getNoDifferentColors() == null && variables.getLifeTotal() == null
+                && variables.getColorToCheck() == null && variables.getTargetValidTargeting() == null
+                && !variables.targetsSingleTarget() && variables.getClassLevel() == null
+                && variables.getManaSpent().isEmpty() && variables.getManaNotSpent().isEmpty();
+    }
