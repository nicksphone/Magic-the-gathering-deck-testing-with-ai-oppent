+    private static void narrowSacrificePreference(final Player ai, final Card host, final List<Card> victims) {
+        if (host.hasSVar("AIPreferenceOverride") || host.hasSVar("AIPreferenceParams") || host.hasSVar("AIPreferBestCard")) return;
+        final String preference = host.getSVar("AIPreference").trim();
+        if (!preference.isEmpty() && !"SacCost$Creature.token".equals(preference)) return;
+        final CardCollection preferred = new CardCollection();
+        if (!preference.isEmpty()) {
+            for (Card card : victims) if (card.isCreature() && card.isToken()) preferred.add(card);
+        }
+        if (preferred.isEmpty() && ai.getGame().getStack().isEmpty() && !ai.getGame().getPhaseHandler().inCombat()) {
+            int priority = 0;
+            for (Card card : victims) {
+                if (card.isLand() || (card.hasSVar("SacMe") && !card.getSVar("SacMe").matches("[1-6]"))) return;
+                if (card.hasSVar("SacMe")) priority = Math.max(priority, Integer.parseInt(card.getSVar("SacMe")));
+            }
+            for (Card card : victims) if (priority > 0 && Integer.toString(priority).equals(card.getSVar("SacMe"))) preferred.add(card);
+        }
+        // Preserve every native preference tie; no RNG and no assumed payment choice.
+        if (!preferred.isEmpty()) { victims.clear(); victims.addAll(preferred); }
+    }
