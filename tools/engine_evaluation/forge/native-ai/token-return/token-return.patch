+    private static boolean knownSimpleManaAvailable(final Player ai, final SpellAbility sa) {
+        if (!sa.getPayCosts().hasManaCost()) return true;
+        final ManaCost cost = sa.getPayCosts().getCostMana().getMana();
+        // String-color payment carries no snow provenance; leave these costs to native admission.
+        for (var shard : cost) if (shard.isSnow()) return false;
+        final ManaCostBeingPaid unpaid = new ManaCostBeingPaid(cost);
+        for (var mana : ai.getManaPool()) {
+            if (!mana.isRestricted()) unpaid.ai_payMana(mana.toString(), ai.getManaPool());
+        }
+        for (Card land : ai.getCardsIn(ZoneType.Battlefield)) {
+            if (unpaid.isPaid()) return true;
+            if (land == sa.getHostCard() || !knownTo(ai, land) || !land.isBasicLand()
+                    || land.isCreature() || land.isTapped() || land.isPhasedOut()) continue;
+            for (SpellAbility mana : land.getManaAbilities()) {
+                if (!"Mana".equals(mana.getParam("AB")) || !mana.getParamOrDefault("Produced", "").matches("[WUBRGC]")
+                        || !Set.of("AB", "Cost", "Produced", "SpellDescription", "Undoable", "Secondary").containsAll(mana.getMapParams().keySet())
+                        || mana.getPayCosts() == null || mana.getPayCosts().getCostParts().size() != 1
+                        || !(mana.getPayCosts().getCostParts().get(0) instanceof CostTap)) continue;
+                unpaid.ai_payMana(mana.getParam("Produced"), ai.getManaPool());
+                break;
+            }
+        }
+        return unpaid.isPaid();
+    }
