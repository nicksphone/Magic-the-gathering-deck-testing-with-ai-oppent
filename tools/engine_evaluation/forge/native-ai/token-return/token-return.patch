+    private static int minimumTokenAmount(final SpellAbility sa, final boolean hasVictim) {
+        final String amount = sa.getParamOrDefault("TokenAmount", "1");
+        if (amount.matches("[1-9][0-9]?")) return Integer.parseInt(amount);
+        if (!hasVictim || !sa.hasSVar(amount)) return -1;
+        final java.util.regex.Matcher comparison = java.util.regex.Pattern.compile(
+                "Count\\$Compare ([A-Za-z][A-Za-z0-9]*) GE[0-9]+\\.([1-9][0-9]?)\\.([1-9][0-9]?)")
+                .matcher(sa.getSVar(amount));
+        if (!comparison.matches() || !"Sacrificed$CardToughness".equals(sa.getSVar(comparison.group(1)))) return -1;
+        return Math.min(Integer.parseInt(comparison.group(2)), Integer.parseInt(comparison.group(3)));
+    }
