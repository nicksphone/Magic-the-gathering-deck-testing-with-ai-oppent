+    private static boolean hasKnownWinningTokenReturn(final Player ai, final SpellAbility sa) {
+        if (ai == null || sa == null || !knownTo(ai, sa.getHostCard())) return false;
+        final Card host = sa.getHostCard();
+        if (!host.getController().equals(ai) || !host.isInPlay() || host.isPhasedOut()
+                || !sa.isActivatedAbility() || sa.isManaAbility() || sa.getApi() != ApiType.Token
+                || !simpleAbility(sa) || !"You".equals(sa.getParam("TokenOwner"))
+                || !Set.of("AB", "Cost", "TokenScript", "TokenAmount", "TokenOwner", "SpellDescription",
+                    "StackDescription", "ActivationZone").containsAll(sa.getMapParams().keySet())
+                || (sa.hasParam("ActivationZone") && !"Battlefield".equals(sa.getParam("ActivationZone")))) return false;
+        final CardCollection sources = tokenReturnSources(ai);
+        if (sources == null) return false;
+        final String script = sa.getParamOrDefault("TokenScript", "");
+        final CardRules token = StaticData.instance().getAllTokens().getRules().get(script);
+        if (token == null || token.getMainPart() == null || token.getOtherPart() != null
+                || token.getType().isCreature() || !Iterables.isEmpty(token.getMainPart().getTriggers())
+                || !Iterables.isEmpty(token.getMainPart().getReplacements())
+                || !Iterables.isEmpty(token.getMainPart().getStaticAbilities())
+                || !Iterables.isEmpty(token.getMainPart().getKeywords())) return false;
+        CostSacrifice sacrifice = null;
+        for (CostPart part : sa.getPayCosts().getCostParts()) {
+            if (part instanceof CostSacrifice sac) {
+                if (sacrifice != null || !"1".equals(sac.getAmount()) || sac.payCostFromSource()
+                        || !Set.of("Creature", "Creature.Other", "Creature.YouCtrl", "Creature.Other+YouCtrl")
+                            .contains(sac.getType())) return false;
+                sacrifice = sac;
+            } else if (part instanceof CostPartMana mana) {
+                if (mana.getMana().countX() != 0 || mana.getMana().hasPhyrexian()) return false;
+            } else if (!(part instanceof CostTap) || !part.canPay(sa, ai, false)) return false;
+        }
+        // No joint mana/sacrifice reservation model: do not spend a proposed victim twice.
+        if (sacrifice != null && sa.getPayCosts().hasManaCost()
+                && !sa.getPayCosts().getCostMana().getMana().isZero()) return false;
+        if (!knownSimpleManaAvailable(ai, sa)) return false;
+        final int quantity = minimumTokenAmount(sa, sacrifice != null);
+        if (quantity < 1 || moveLoss(ai, sources, null, token, ZoneType.None, ZoneType.Battlefield, null) < 0
+                || moveLoss(ai, sources, null, token, ZoneType.Battlefield, ZoneType.Graveyard, null) < 0) return false;
+        final List<Card> victims = new ArrayList<>();
+        if (sacrifice != null) {
+            for (Card card : ai.getCardsIn(ZoneType.Battlefield)) {
+                if (knownTo(ai, card) && !card.isPhasedOut() && card.canBeSacrificedBy(sa, false)
+                        && card.isValid(sacrifice.getType().split(";"), ai, host, sa)) victims.add(card);
+            }
+            if (victims.isEmpty()) return false;
+            narrowSacrificePreference(ai, host, victims);
+        } else {
+            // Null denotes the real mana/tap-only producer: no virtual creature death.
+            victims.add(null);
+        }
+        for (Card victim : victims) {
+            final long death = victim == null ? 0 : moveLoss(ai, sources, victim, null,
+                    ZoneType.Battlefield, ZoneType.Graveyard, null);
+            if (death < 0) return false;
+            boolean wins = false;
+            final CardCollection returns = new CardCollection(ai.getCardsIn(ZoneType.Graveyard));
+            if (victim != null && victim.getOwner().equals(ai)) returns.add(victim);
+            for (Card returning : returns) {
+                if (!knownTo(ai, returning) || !returning.getOwner().equals(ai) || returning.isToken() || !returning.isCreature()
+                        || returning.isCloned() || returning.hasAlternateState() || returning.isFaceDown()) continue;
+                for (SpellAbility back : returning.getSpellAbilities()) {
+                    if (!back.isIntrinsic() || back.getApi() != ApiType.ChangeZone || !simpleAbility(back)
+                            || back.getRestrictions().getZone() != ZoneType.Graveyard
+                            || !unrestrictedVariables(back.getRestrictions()) || !unrestrictedVariables(back.getConditions())
+                            || (back.getActivatingPlayer() != null && !back.getActivatingPlayer().equals(ai))
+                            || !back.getConditions().areMet(back)
+                            || !Set.of("AB", "Cost", "Origin", "Destination", "ActivationZone", "Defined",
+                                "SpellDescription", "StackDescription").containsAll(back.getMapParams().keySet())
+                            || !"Graveyard".equals(back.getParam("Origin"))
+                            || !"Battlefield".equals(back.getParam("Destination"))
+                            || !"Graveyard".equals(back.getParam("ActivationZone"))
+                            || (back.hasParam("Defined") && !"Self".equals(back.getParam("Defined")))) continue;
+                    CostSacrifice resource = null;
+                    boolean supported = true;
+                    for (CostPart part : back.getPayCosts().getCostParts()) {
+                        if (part instanceof CostSacrifice sac && resource == null && !sac.payCostFromSource()
+                                && sac.getAmount().matches("[1-9][0-9]?")
+                                && sac.getType().matches("[A-Za-z]+")
+                                && token.getType().hasStringType(sac.getType())) resource = sac;
+                        else if (!(part instanceof CostPartMana mana && mana.getMana().isZero())) supported = false;
+                    }
+                    if (!supported || resource == null) continue;
+                    int available = quantity;
+                    long possiblyConsumedPayoff = 0;
+                    for (Card card : ai.getCardsIn(ZoneType.Battlefield)) {
+                        if (card != victim && knownTo(ai, card) && card.canBeSacrificedBy(back, false)
+                                && card.isValid(resource.getType().split(";"), ai, returning, back)) {
+                            // Every actual candidate resource must have harmless departure too.
+                            if (moveLoss(ai, sources, card, null, ZoneType.Battlefield, ZoneType.Graveyard, victim) < 0) {
+                                available = -1000;
+                                break;
+                            }
+                            final long contribution = moveLoss(ai, new CardCollection(card), returning, null,
+                                    ZoneType.Graveyard, ZoneType.Battlefield, victim);
+                            if (contribution < 0) { available = -1000; break; }
+                            possiblyConsumedPayoff += contribution;
+                            available++;
+                        }
+                    }
+                    if (available < Integer.parseInt(resource.getAmount())) continue;
+                    final long entry = moveLoss(ai, sources, returning, null, ZoneType.Graveyard, ZoneType.Battlefield, victim);
+                    // A real payment can remove any eligible resource. Never credit its future payoff.
+                    if (entry >= 0 && death + entry - possiblyConsumedPayoff >= ai.getOpponents().get(0).getLife()) wins = true;
+                }
+            }
+            if (!wins) return false;
+        }
+        return true;
+    }
