+    private boolean isLethalDamageToPlayer(final Player enemy, final Card source, final int damage,
+            final boolean noPrevention) {
+        if (damage <= 0 || !enemy.canLoseLife() || enemy.cantLoseForZeroOrLessLife()
+                || source.isInfectDamage(enemy)) {
+            return false;
+        }
+        final int predicted = noPrevention ? enemy.staticReplaceDamage(damage, source, false)
+                : ComputerUtilCombat.predictDamageTo(enemy, damage, source, false);
+        return predicted > 0 && predicted >= enemy.getLife();
+    }
