+    private boolean hasExpiringLandPermission(final Card land) {
+        if (!land.isInZone(ZoneType.Exile) || !land.getView().canBeShownTo(player.getView())
+                || !land.getView().canFaceDownBeShownTo(player.getView())) {
+            return false;
+        }
+        boolean grantsAccess = false;
+        for (final CardPlayOption option : land.mayPlay(player)) {
+            if (!option.appliesTo(player) || !option.grantsZonePermissions()) {
+                continue;
+            }
+            final Card effect = option.getHost();
+            if (effect == null || !effect.getView().canBeShownTo(player.getView())
+                    || !effect.getView().canFaceDownBeShownTo(player.getView())
+                    || !effect.isImmutable() || !effect.isInZone(ZoneType.Command)) {
+                return false;
+            }
+            final SpellAbility creator = effect.getEffectSourceAbility();
+            if (creator == null || creator.getHostCard() == null
+                    || !creator.getHostCard().getView().canBeShownTo(player.getView())
+                    || !creator.getHostCard().getView().canFaceDownBeShownTo(player.getView())
+                    || creator.getApi() != ApiType.Effect) {
+                return false;
+            }
+            // EffectEffect's absent duration schedules EOT; other creation paths cannot establish that.
+            final String duration = creator.getParam("Duration");
+            if (duration != null && !"UntilEndOfTurn".equals(duration)) {
+                return false;
+            }
+            grantsAccess = true;
+        }
+        return grantsAccess;
     }
 
